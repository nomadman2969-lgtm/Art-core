# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=artcore
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@artcorestudio.net
ADMIN_PASSWORD=change-me
CORS_ORIGINS=https://artcorestudio.net,https://www.artcorestudio.net
PUBLIC_APP_URL=https://artcorestudio.net
# Must be set (the server reads it at import); a test key is fine until launch.
STRIPE_SECRET_KEY=sk_test_xxx

# --- Commerce (can also be set from /admin -> Stripe) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=

# --- AI features (listing assistant, studio designer, polish) ---
EMERGENT_LLM_KEY=

# --- Optional ---
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
# Demo accounts are skipped when these are empty
DEMO_ARTIST_PASSWORD=
DEMO_COLLECTOR_PASSWORD=
